{
  "name": "open-stacks-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A free, static, browser-only trainer for memorized card stacks.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
